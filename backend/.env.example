# =============================================================================
# CascadeZero Backend — Environment Variables Template
# Copy to .env and fill in your credentials
# =============================================================================

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # server-only; required once RLS is enabled

# Google Gemini (REQUIRED for AI agents)
GEMINI_API_KEY=your_gemini_api_key_here
# Must be a model ID your key can access; the UI shows when calls fall back to templates
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Business Cloud API (Alternative)
META_WA_ACCESS_TOKEN=your_meta_wa_token_here
META_WA_PHONE_NUMBER_ID=your_meta_wa_phone_number_id_here
META_WA_VERIFY_TOKEN=generate_a_random_token_here
# App secret from developers.facebook.com → App settings → Basic (verifies webhook signatures)
META_APP_SECRET=your_meta_app_secret_here
# Comma-separated numbers (country code, digits only) allowed to approve plans via WhatsApp
WA_APPROVER_NUMBERS=919800000000

# Twilio WhatsApp (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OpenWeatherMap (OPTIONAL — for live highway weather)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Security
# "production" refuses to start unless the API key, Meta app secret and explicit origins are set
CASCADE_ENV=development
# Shared operator key for mutating endpoints (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
CASCADE_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sourcing Agent: "simulated" (enter vendor replies on the dashboard) or "whatsapp"
# (enquiries go to suppliers.whatsapp_number; outside Meta's 24h window an approved template is required)
SOURCING_MODE=simulated
SOURCING_REPLY_TIMEOUT_MIN=30
SOURCING_MAX_ROUNDS=3
