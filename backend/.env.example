# =============================================================================
# CascadeZero Backend — Environment Variables Template
# Copy to .env and fill in your credentials
# =============================================================================

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # server-only; required once RLS is enabled

# Google Gemini (REQUIRED for AI agents)
GEMINI_API_KEY=your_gemini_api_key_here
# Must be a model ID your key can access; the UI shows when calls fall back to templates
GEMINI_MODEL=gemini-3.1-flash-lite

# Telegram Bot API (the chat channel). Token from @BotFather; the webhook secret is the
# secret_token you pass to setWebhook (unset: the webhook refuses every update).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OpenWeatherMap (OPTIONAL — for live highway weather)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Security
# "production" refuses to start unless the required secrets and explicit origins are set
CASCADE_ENV=development
# Users sign in with Supabase Auth (Authorization: Bearer). Roles per factory live in factory_members:
#   python -m app.admin add-member --email E --factory F --role owner|approver|viewer
# AUTH_MODE=dev (offline storage only; refused in production or with Supabase) trusts X-Dev-User.
AUTH_MODE=supabase
# Machine key for automation on /api/v1/ingest/* and /api/v1/simulate-crisis only (X-API-Key);
# the browser never sends it. Unset = no machine access. (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
CASCADE_API_KEY=
# The factory the machine key acts on (as an approver); defaults to FACTORY_ID / apex-volt-blr2
CASCADE_API_KEY_FACTORY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sourcing Agent: "simulated" (enter vendor replies on the dashboard) or "telegram"
# (enquiries go to suppliers.telegram_chat_id)
SOURCING_MODE=simulated
SOURCING_REPLY_TIMEOUT_MIN=30
SOURCING_MAX_ROUNDS=3
