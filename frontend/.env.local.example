# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend FastAPI URL (server-side only; the browser talks to /api/v1 on this app)
BACKEND_URL=http://localhost:8000

# Must equal CASCADE_API_KEY in backend/.env. Server-side only — do NOT prefix with NEXT_PUBLIC_.
CASCADE_API_KEY=
